# build outputs (regenerated by `make`; released through GitHub releases)
build/

# node tooling used only to run the emulator harness
node_modules/
package-lock.json
package.json

# python tooling used only to run the stub-firmware harness (and by CI)
.venv/

# a user's own firmware image and the manifest derived from it: the image is
# never redistributable and the manifest is machine-specific
firmware/

# python bytecode from the host test suite
__pycache__/
*.pyc

# the PS5 system-software package (ADR-022): the tracked file at the repository
# root is a git-lfs pointer, never the payload. Any copy that is analysed lives
# outside this repository, and nothing derived from it is ever committed.
pup-analysis*.json
firmware-analysis/
*.pup.part

# .NET build output under app/ (the tree the `windows app` workflow writes into). These are
# generated by `dotnet build`; `tests/test_pc5_app_structure.py` also skips them, because a
# gate that walks `app/` looking at *source* must not be judging `obj/Debug/**/AssemblyInfo.cs`.
app/**/bin/
app/**/obj/
app/**/TestResults/
**/*.user
