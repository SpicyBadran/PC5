<Project Sdk="Microsoft.NET.Sdk">

  <!-- PC5.exe: the Windows 11 host application. Deliberately thin. It owns the window,
       the input surface and the presentation of state that PC5.Core computes, and it owns
       the Windows-only capability probes. No execution decision and no lifecycle rule lives
       here, so none of them can depend on WinUI being available.

       WindowsPackageType=MSIX produces the packaged application install; the output name is
       PC5.exe because the product is named for that executable.

       Microsoft.WindowsAppSDK 1.6.2 is a verified pin, not a guess: run 46110354254 restored
       it on a windows-latest runner ("Restore the application": success). The build of this
       project failed in the next step of the same run, and this file does not pretend to know
       why: the cause belongs to the run's record (docs/EXPERIMENTS.md, EXP-L), not to a
       comment. What is NOT in doubt: no packaging or signing certificate is referenced here,
       because M29 owns that and its identity deliberately lives outside this repository. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Pc5.App</RootNamespace>
    <AssemblyName>PC5</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon />
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0-dev-pc5-app-foundation</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PC5.Core\PC5.Core.csproj" />
  </ItemGroup>

</Project>
