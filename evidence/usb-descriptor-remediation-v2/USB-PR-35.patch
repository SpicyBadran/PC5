+_REAL_OPEN = os.open
+_REAL_CLOSE = os.close
+_REAL_FSTAT = os.fstat
+_REAL_LSTAT = os.lstat
+_REAL_READLINK = os.readlink
+_REAL_EXISTS = os.path.exists
+_REAL_CALL = subprocess.call
